# OpenAI-compatible API configuration
# The app calls a chat-completions endpoint using the EVA system prompt.

# Required: API key for your provider (OpenAI, Azure OpenAI, OpenRouter, local, etc.)
OPENAI_API_KEY=

# Optional: override the base URL for OpenAI-compatible providers
# e.g. https://openrouter.ai/api/v1  or  http://localhost:11434/v1 (Ollama)
# OPENAI_BASE_URL=

# Optional: model name (defaults to gpt-4o-mini)
# EVA_MODEL=gpt-4o-mini
